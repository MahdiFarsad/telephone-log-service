# Simotel webhook auth
SIMOTEL_API_TOKEN=change-this
SIMOTEL_TOKEN_PARAM_NAME=api_key

# MongoDB (hot store)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=telephone_log_service
MONGO_COLLECTION=call_logs

# SQL Server (cold store)
SQLSERVER_CONN_STR=Driver
SQLSERVER_TABLE=dbo.tblCallLog

# ETL
ETL_INTERVAL_MINUTES=5
ETL_BATCH_SIZE=500

# Direction derivation (tune after Phase 0 test calls)
EXTENSION_MIN_LENGTH=3
EXTENSION_MAX_LENGTH=5

# Hot store retention
HOT_STORE_RETENTION_DAYS=90
